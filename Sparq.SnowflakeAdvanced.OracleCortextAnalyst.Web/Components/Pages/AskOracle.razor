@page "/ask"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Sparq.SnowflakeAdvanced.OracleCortextAnalyst.DataModels
@inject SalesApiClient _salesApi
@inject NotificationService _notificationService

<PageTitle>Ask Oracle</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" Style="height: calc(100vh - 140px);">

    <RadzenCard Variant="Variant.Outlined" Style="padding: 0.75rem;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
            <RadzenText TextStyle="TextStyle.H5" class="m-0">Ask Oracle</RadzenText>

            <RadzenLabel Text="Model:" Component="ModelDropdown" />
            <RadzenDropDown @bind-Value="@selectedModel"
                            Name="ModelDropdown"
                            Data="@availableModels"
                            TValue="string"
                            Style="width: 220px;" />

            <RadzenButton Icon="delete_sweep"
                          Text="Clear"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@ClearChat"
                          Disabled="@(messages.Count == 0 || isAsking)" />
        </RadzenStack>
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" Style="flex: 1 1 auto; overflow-y: auto; padding: 1rem; background-color: var(--rz-base-50);">
        @if (messages.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">
                Ask anything backed by Snowflake Cortex. Conversation history is sent with each request to preserve context.
            </RadzenText>
        }

        @foreach (var message in messages)
        {
            var isUser = message.Role == "user";
            <div class="@(isUser ? "d-flex justify-content-end mb-2" : "d-flex justify-content-start mb-2")">
                <RadzenCard Variant="Variant.Filled"
                            Style="@($"max-width: 75%; background-color: {(isUser ? "var(--rz-primary-lighter)" : "var(--rz-base-100)")};")">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary">
                            @(isUser ? "You" : $"Oracle ({message.Role})") • @message.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1" Style="white-space: pre-wrap;">@message.Content</RadzenText>
                    </RadzenStack>
                </RadzenCard>
            </div>
        }

        @if (isAsking)
        {
            <div class="d-flex justify-content-start mb-2">
                <RadzenCard Variant="Variant.Filled" Style="background-color: var(--rz-base-100);">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
                        <RadzenText TextStyle="TextStyle.Body2">Oracle is thinking…</RadzenText>
                    </RadzenStack>
                </RadzenCard>
            </div>
        }
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined" Style="padding: 0.75rem;">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End">
            <RadzenTextArea @bind-Value="@prompt"
                            Placeholder="Type your question and press Enter (Shift+Enter for newline)…"
                            Rows="2"
                            Style="flex: 1 1 auto;"
                            Disabled="@isAsking"
                            @onkeydown="@HandleKeyDown" />
            <RadzenButton Icon="send"
                          Text="Send"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@SendAsync"
                          Disabled="@(isAsking || string.IsNullOrWhiteSpace(prompt))" />
        </RadzenStack>
    </RadzenCard>

</RadzenStack>

@code {
    readonly List<DataModels.ChatMessage> messages = new();
    readonly string[] availableModels = new[]
    {
        "mistral-large2",
        "llama3.1-70b",
        "llama3.1-8b",
        "mixtral-8x7b",
        "snowflake-arctic"
    };

    string selectedModel = "mistral-large2";
    string prompt = string.Empty;
    bool isAsking;

    private async Task SendAsync()
    {
        if (isAsking || string.IsNullOrWhiteSpace(prompt)) return;

        var userText = prompt.Trim();
        prompt = string.Empty;

        var userMessage = new DataModels.ChatMessage
        {
            Role = "user",
            Content = userText,
            Timestamp = DateTime.UtcNow
        };

        // Capture history *before* appending the new user message — the controller appends it itself.
        var historySnapshot = messages.Select(m => new DataModels.ChatMessage
        {
            Role = m.Role,
            Content = m.Content,
            Timestamp = m.Timestamp
        }).ToList();

        messages.Add(userMessage);
        isAsking = true;
        StateHasChanged();

        try
        {
            var response = await _salesApi.AskAsync(new AskRequest
            {
                Prompt = userText,
                Model = selectedModel,
                History = historySnapshot
            });

            messages.Add(new DataModels.ChatMessage
            {
                Role = "assistant",
                Content = string.IsNullOrWhiteSpace(response.Reply) ? "(no response)" : response.Reply,
                Timestamp = DateTime.UtcNow
            });

            _notificationService.Notify(NotificationSeverity.Success,
                "Oracle responded",
                $"{response.Model} • {response.ElapsedMs} ms",
                TimeSpan.FromSeconds(2));
        }
        catch (Exception ex)
        {
            messages.Add(new DataModels.ChatMessage
            {
                Role = "assistant",
                Content = $"⚠️ Error: {ex.Message}",
                Timestamp = DateTime.UtcNow
            });
            _notificationService.Notify(NotificationSeverity.Error, "Cortex call failed", ex.Message, TimeSpan.FromSeconds(6));
        }
        finally
        {
            isAsking = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Enter sends; Shift+Enter inserts a newline.
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    private void ClearChat()
    {
        messages.Clear();
    }
}
